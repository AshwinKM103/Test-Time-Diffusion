# ── FineWeb Search API (original competition backend) ─────────────────────
FINEWEB_API_KEY=your_fineweb_api_key_here

# ── OpenRouter API (fallback when no local GPU is available) ──────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=alibaba/tongyi-deepresearch-30b-a3b:free

# ── Tavily Search API (default retrieval backend) ─────────────────────────
# Sign up for a free key at https://app.tavily.com (1,000 credits/month)
# Free tier: 1 credit per basic search request
# At 20 iterations per query, 50 full research queries can be run per month.
TAVILY_API_KEY=tvly-your_key_here

# ── Retrieval backend selector ─────────────────────────────────────────────
# Options: "tavily" (default) | "fineweb"
RETRIEVAL_BACKEND=tavily

# ── Pipeline hyperparameters ───────────────────────────────────────────────
# Maximum search/revision iterations (paper uses up to 20)
MAX_SEARCH_ITERATIONS=20

# Minimum iterations before the exit-loop judge is consulted
N_MIN_BEFORE_EXIT=5

# Number of candidate search queries generated per iteration (paper n_q=5)
NUM_SEARCH_QUERY_VARIANTS=5

# Self-evolution parameters for plan/answer generation
NUM_VARIANTS=1
EVOLUTION_STEPS=1

# Self-evolution parameters for final report (paper: n_r=1 or 5, s_r=0 or 1)
REPORT_NUM_VARIANTS=1
REPORT_EVOLUTION_STEPS=1

# ── Server ─────────────────────────────────────────────────────────────────
PORT=5053